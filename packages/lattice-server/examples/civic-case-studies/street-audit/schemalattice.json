        {"name": "locationAccuracyM", "type": "number", "unit": "m"},
        {"name": "address", "type": "string"},
        {"name": "conditionType", "type": "reference", "required": true},
        {"name": "severity", "type": "integer", "values": [1,2,3,4]},
        {"name": "detail", "type": "string"},
        {"name": "photo", "type": "binary", "classification": "internal"},
        {"name": "photoRedacted", "type": "boolean"},
        {"name": "reporter", "type": "reference", "classification": "personal-identity"},
        {"name": "parcelRef", "type": "reference"},
        {"name": "wardRef", "type": "reference"},
        {"name": "neighborhoodRef", "type": "reference"},
        {"name": "nearestTreeRef", "type": "reference"},
        {"name": "nearestTreeDistanceM", "type": "number", "unit": "m"},
        {"name": "category", "type": "reference", "notes": "the receiving city's 311 Report Category, set at forward time"},
        {"name": "forwardConsent", "type": "boolean"},
        {"name": "forwardedReportId", "type": "string"},
        {"name": "state", "type": "string", "values": ["draft","reviewed","forwarded","closed-by-city","withdrawn"]}
      ]
    },
    "AuditSession": {
      "status": "originated",
      "definition": "One walk audit: a group of volunteers surveying a defined set of blocks on one date under a named protocol version.",
      "broader": "https://schemalattice.com/c/schemalattice/event@04b611d4b94c",
      "notes": "Nearest existing: volunteer-engagement/volunteer-event (scheduling-heavy) and trail-stewardship/condition-report (trail-only). coRefersWith candidate for volunteer-event.",
