        {"name": "sessionId", "type": "string", "required": true},
        {"name": "organizer", "type": "reference"},
        {"name": "date", "type": "date", "required": true},
        {"name": "area", "type": "string", "notes": "blocks or route walked (GeoJSON)"},
        {"name": "protocol", "type": "string", "notes": "e.g. street-audit/1.0; makes audits comparable"},
        {"name": "volunteerCount", "type": "integer"}
      ]
    },
    "ConditionType": {
      "status": "originated",
      "definition": "A kind of street condition an auditor can record, independent of any one city's 311 categories, with a crosswalk to each city's categories.",
      "broader": "https://schemalattice.com/c/schemalattice/classification@be6d933fd7e8",
      "fields": [
        {"name": "code", "type": "string", "required": true, "values": ["sidewalk.trip-hazard","sidewalk.missing-segment","curb-ramp.missing","curb-ramp.noncompliant","tree.dead","tree.missing-empty-pit","tree.hazard-limb","streetlight.out","streetlight.damaged","access.obstruction"]},
        {"name": "label", "type": "string"},
        {"name": "group", "type": "string", "values": ["sidewalk","tree","streetlight","accessibility"]}
      ]
    },
    "ReportCategory": { "uri": "https://schemalattice.com/c/civic-issue-reporting/report-category@b3bdd478944f", "status": "adopted" },
    "CivicBody":      { "uri": "https://schemalattice.com/c/civic-issue-reporting/civic-body@ef79d8c6a015", "status": "adopted" },
    "StreetTree":     { "uri": "https://schemalattice.com/c/urban-forest/street-tree@734dac02adbb", "status": "adopted", "notes": "reference only; read from new-haven-street-trees" },
    "District":       { "uri": "https://schemalattice.com/c/civic-participation/city-district@bd808dfd5db4", "status": "adopted", "notes": "ward and neighborhood polygons" },
    "Parcel":         { "uri": "https://schemalattice.com/c/real-property/land-parcel@8c8591f76678", "status": "adopted", "notes": "reference by pin/mblu only; never copy ownerName or mailingAddress" }
  },
