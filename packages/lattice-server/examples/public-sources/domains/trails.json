 "concepts": [
  {
   "context": "trail-stewardship",
   "conceptSlug": "trail-system",
   "prefLabel": "Trail System",
   "altLabels": [
    "trail network",
    "greenway",
    "named trail"
   ],
   "definition": "A named trail or trail network that people know as one place, such as a rail trail, a greenway or a preserve's trail network, made up of physical segments and listed by its manager and by trail finders.",
   "conceptKind": "entity",
   "broaderRoot": "location",
   "closeMatch": [
    "wd:Q2143825"
   ],
   "coRefersRationale": "Nothing in the catalog describes a named trail; OpenTrails named_trails and OSM route relations are the outside equivalents but have no approved prefix.",
