            "classification": "internal"
          },
          {
            "name": "startedAt",
            "type": "datetime",
            "classification": "internal"
          },
          {
            "name": "resolvedAt",
            "type": "datetime",
            "classification": "internal"
          },
          {
            "name": "dailyRate",
            "type": "number",
