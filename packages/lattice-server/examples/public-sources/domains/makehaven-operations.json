    {
      "context": "space-rental",
      "conceptSlug": "storage-violation",
      "prefLabel": "Storage Violation",
      "altLabels": [
        "Storage Rule Violation",
        "Overflow Fine",
        "Storage Infraction"
      ],
      "definition": "A breach of a facility's storage rules by the holder of a storage unit, such as items left outside the unit, open from when it was recorded until staff resolve it, accruing a daily charge and closing with a total due or waived.",
