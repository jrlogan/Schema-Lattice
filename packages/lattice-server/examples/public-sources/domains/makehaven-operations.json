    {
      "context": "equipment-maintenance",
      "conceptSlug": "equipment-log-entry",
      "prefLabel": "Equipment Log Entry",
      "altLabels": [
        "Asset Log Entry",
        "Tool Status Report",
        "Service Log Entry",
        "Out-of-Service Notice"
      ],
      "definition": "A dated entry in one machine's service history that is not tied to a vessel: a reported or staff-confirmed status change, an inspection, or maintenance work, with who logged it, a photo, and when the machine is expected back in service.",
      "conceptKind": "event",
      "broaderRoot": "activity",
      "forkOf": "https://schemalattice.com/c/equipment-maintenance/maintenance-event@944e7017caf9",
      "changeset": {
        "ops": [
          {
            "op": "rename",
            "from": "vesselId",
            "to": "equipment"
          },
          {
            "op": "retype",
            "field": "equipment",
            "fromType": "reference",
            "toType": "reference",
            "converter": "identity",
            "note": "Target changes from vessel-ops/vessel to makerspace-operations/equipment (any shared machine)"
          },
          {
            "op": "remove",
            "field": "category"
          },
          {
            "op": "retype",
            "field": "kind",
            "fromType": "enum",
            "toType": "enum",
            "converter": "identity",
            "note": "Adds the values maintenance and status_change; parent values unchanged"
          },
          {
            "op": "add",
            "field": "reportedStatus",
            "type": "string",
            "description": "Condition a user reported, e.g. needs repair"
          },
          {
            "op": "add",
            "field": "confirmedStatus",
            "type": "string",
            "description": "Status staff confirmed after triage"
          },
          {
            "op": "add",
            "field": "expectedBackAt",
            "type": "datetime",
            "description": "When out-of-service equipment should be usable again"
          }
        ],
        "note": "Generalises the vessel-oriented maintenance event to any shared equipment: the vessel reference becomes an equipment reference, the vessel-systems category is dropped, and status-change triage fields are added."
      },
      "structure": {
        "kind": "event",
        "fields": [
          {
            "name": "equipment",
            "type": "reference",
            "required": true,
            "refUri": "https://schemalattice.com/c/makerspace-operations/equipment@73a23efa789f",
            "description": "The machine or tool the entry is about"
          },
          {
            "name": "scheduleId",
            "type": "reference",
            "ref": "equipment-maintenance/maintenance-schedule"
          },
          {
            "name": "kind",
            "type": "enum",
            "values": [
              "scheduled",
              "repair",
              "improvement",
              "inspection",
              "maintenance",
              "status_change"
            ],
            "required": true
          },
          {
            "name": "title",
            "type": "string",
            "required": true
          },
          {
            "name": "description",
            "type": "string"
          },
          {
            "name": "performedAt",
            "type": "datetime",
            "required": true
          },
          {
            "name": "hoursAtService",
            "type": "number"
          },
          {
            "name": "cost",
            "type": "object",
            "fields": [
              {
                "name": "amount",
                "type": "integer",
                "required": true
              },
              {
                "name": "currency",
                "type": "string",
                "required": true
              }
            ],
            "classification": "personal-financial"
          },
          {
            "name": "performedBy",
            "type": "string"
          },
          {
            "name": "laborHours",
            "type": "number",
            "unit": "hours"
          },
          {
            "name": "performedByPersonIds",
            "type": "array",
            "itemType": "reference"
          },
          {
            "name": "parts",
            "type": "array",
            "itemType": "object",
            "fields": [
              {
                "name": "name",
                "type": "string",
                "required": true
              },
              {
                "name": "partNumber",
                "type": "string"
              },
              {
                "name": "quantity",
                "type": "number"
              }
            ]
          },
          {
            "name": "photoIds",
            "type": "array",
            "itemType": "string"
          },
          {
            "name": "reportedStatus",
            "type": "string",
            "classification": "public",
            "description": "Condition a user reported, e.g. needs repair"
          },
          {
            "name": "confirmedStatus",
            "type": "string",
            "classification": "public",
            "description": "Status staff confirmed after triage"
          },
          {
            "name": "expectedBackAt",
            "type": "datetime",
            "classification": "public",
            "description": "When out-of-service equipment should be usable again"
          }
        ]
      },
      "sourceAttribution": {
        "importedFrom": "https://schemalattice.com/c/equipment-maintenance/maintenance-event@944e7017caf9",
        "authoredBy": [
          "SchemaLattice makerspace deep-pass pilot"
        ],
        "sourceNotes": "From the asset_status module's asset_log_entry content entity (src/Entity/AssetLogEntry.php base fields: asset, summary, details, photo, reported_status, confirmed_status, expected_back, user_id, created) and its bundles status_change / maintenance / inspection (config/asset_status.asset_log_entry_type.*.yml)."
      }
    },
