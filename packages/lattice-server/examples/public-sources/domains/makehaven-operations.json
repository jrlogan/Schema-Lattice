    {
      "context": "makerspace-operations",
      "conceptSlug": "shop-equipment-asset",
      "prefLabel": "Shop Equipment Asset",
      "altLabels": [
        "Equipment Asset Record",
        "Tool Page",
        "Asset Register Entry"
      ],
      "definition": "A shared workshop machine or tool as kept on the space's asset register: everything a basic equipment record holds plus the kit parts inside it, optional and safety requirements, guest use, booking lead time, use instructions and where it came from.",
      "conceptKind": "entity",
      "broaderRoot": "asset",
      "forkOf": "https://schemalattice.com/c/makerspace-operations/equipment@73a23efa789f",
      "changeset": {
        "ops": [
          {
            "op": "add",
            "field": "components",
            "type": "array",
            "description": "Equipment units tracked separately inside this one (kit parts)"
          },
          {
            "op": "add",
            "field": "optionalBadges",
            "type": "array",
            "description": "Badges for advanced use or attachments, not needed for basic use"
          },
          {
            "op": "add",
            "field": "safetyRequirements",
            "type": "array",
            "description": "Protective equipment or conditions required, e.g. eye protection"
          },
          {
            "op": "add",
            "field": "guestUseAllowed",
            "type": "boolean",
            "description": "Whether guests or supervised minors may use it"
          },
          {
            "op": "add",
            "field": "minAdvanceBookingHours",
            "type": "integer",
            "unit": "h",
            "description": "How far ahead a reservation must be made"
          },
          {
            "op": "add",
            "field": "instructions",
            "type": "string",
            "description": "Steps for safe use"
          },
          {
            "op": "add",
            "field": "acquisitionSource",
            "type": "string",
            "description": "Donor, vendor or lender it came from"
          },
          {
            "op": "add",
            "field": "ownership",
            "type": "string",
            "description": "Owned, on loan, or on consignment"
          },
          {
            "op": "add",
            "field": "imageUrl",
            "type": "url"
          }
        ],
        "note": "Adds the asset-register fields a makerspace equipment page carries (kit composition, optional badges, PPE requirements, guest use, booking lead time, instructions, provenance, ownership, image). All parent fields kept."
      },
