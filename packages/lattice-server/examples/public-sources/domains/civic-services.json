  "concepts": [
    {
      "context": "elections",
      "conceptSlug": "polling-place",
      "prefLabel": "Polling Place",
      "altLabels": [
        "Polling Location",
        "Polling Station",
        "Voting Location"
      ],
      "definition": "A site, usually a school, library or community building, where registered voters of an assigned precinct or voting district cast ballots on election day. It is identified by the districts it serves and the elections it is used for.",
      "conceptKind": "place",
      "broaderRoot": "location",
      "closeMatch": [
        "wd:Q335778"
      ],
      "structure": {
        "kind": "entity",
        "fields": [
          {
            "name": "name",
            "type": "string",
            "classification": "public",
            "description": "Name of the building or site"
          },
          {
            "name": "address",
            "type": "string",
            "classification": "public",
            "description": "Street address of the site (an institutional address)"
          },
          {
            "name": "directions",
            "type": "string",
            "classification": "public",
            "description": "Where in the building to go, e.g. entrance or room"
          },
          {
            "name": "municipality",
            "type": "reference",
            "classification": "public",
            "description": "Town the site is in",
            "refUri": "https://schemalattice.com/c/public-geography/municipality@f24602cb066b"
          },
          {
            "name": "state",
            "type": "string",
            "classification": "public"
          },
          {
            "name": "votingDistrict",
            "type": "reference",
            "classification": "public",
            "description": "Ward or voting district the site serves",
            "refUri": "https://schemalattice.com/c/civic-participation/city-district@bd808dfd5db4"
          },
          {
            "name": "precinct",
            "type": "string",
            "classification": "public",
            "description": "Precinct number or split within the district"
          },
          {
            "name": "stateSenateDistrict",
            "type": "string",
            "classification": "public"
          },
          {
            "name": "stateHouseDistrict",
            "type": "string",
            "classification": "public",
            "description": "State assembly / house district"
          },
          {
            "name": "servesLocalElections",
            "type": "boolean",
            "classification": "public"
          },
          {
            "name": "servesStateElections",
            "type": "boolean",
            "classification": "public"
          },
          {
            "name": "isEarlyVoting",
            "type": "boolean",
            "classification": "public"
          },
          {
            "name": "isDropBox",
            "type": "boolean",
            "classification": "public"
          },
          {
            "name": "location",
            "type": "geometry",
            "classification": "public"
          }
        ]
      },
      "sourceAttribution": {
        "importedFrom": "https://vip-specification.readthedocs.io/en/latest/built_rst/xml/elements/polling_location.html",
        "authoredBy": [
          "SchemaLattice civic-services pilot"
        ],
        "sourceNotes": "Fields shared by the Voting Information Project 5.1.2 PollingLocation/Precinct elements (Name, AddressLine, Directions, LatLng, IsEarlyVoting, IsDropBox, Precinct Number, ElectoralDistrictIds, Locality) and the City of New Haven PollingPlaces_2024 layer (polling_places, addresses, location, dst, prec, sen, ad, municipality, state, local_elections, state_elections)."
      }
    },
    {
      "context": "education",
      "conceptSlug": "school",
      "prefLabel": "School",
      "altLabels": [
        "School Campus",
        "Educational Organization",
        "K-12 School"
      ],
      "definition": "An educational institution or campus that enrolls students in a span of grade levels, run by a district or other operator and identified by state and federal organization codes. Magnet, charter and private institutions are included.",
      "conceptKind": "entity",
      "broaderRoot": "organization",
      "closeMatch": [
        "wd:Q3914",
