          },
          {
            "name": "lowestGrade",
            "type": "string",
            "classification": "public"
          },
          {
            "name": "highestGrade",
            "type": "string",
            "classification": "public"
          },
          {
            "name": "isMagnet",
            "type": "boolean",
            "classification": "public"
          },
          {
            "name": "isCharter",
            "type": "boolean",
            "classification": "public"
          },
          {
            "name": "status",
            "type": "string",
