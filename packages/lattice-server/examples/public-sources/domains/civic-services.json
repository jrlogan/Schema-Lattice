            "description": "e.g. public school, charter, magnet, private"
          },
          {
            "name": "address",
            "type": "string",
            "classification": "public",
            "description": "Campus street address"
          },
          {
            "name": "town",
            "type": "reference",
            "classification": "public",
            "refUri": "https://schemalattice.com/c/public-geography/municipality@f24602cb066b"
          },
          {
            "name": "postalCode",
            "type": "string",
            "classification": "public"
          },
          {
            "name": "phone",
            "type": "string",
            "classification": "public",
