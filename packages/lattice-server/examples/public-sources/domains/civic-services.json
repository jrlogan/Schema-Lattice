            "name": "location",
            "type": "geometry",
            "classification": "public"
          }
        ]
      },
      "sourceAttribution": {
        "importedFrom": "https://data.ct.gov/api/views/9k2y-kqxn.json",
        "authoredBy": [
          "SchemaLattice civic-services pilot"
        ],
        "sourceNotes": "Fields shared by the CT State Department of Education Education Directory (organization_code, name, district_name, organization_type, address, town, zipcode, phone, grade flags, interdistrict_magnet, student_open_date, geocoded_column) and NCES EDGE Public School Administrative Data 2023-24 (NCESSCH, SCH_NAME, LEA_NAME, LSTREET1, LCITY, LZIP, PHONE, GSLO, GSHI, PK..G12, CHARTER_TEXT, SY_STATUS_TEXT, LAT/LON)."
      }
