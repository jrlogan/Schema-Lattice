    {
      "context": "public-statistics",
      "conceptSlug": "area-statistic",
      "prefLabel": "Area Statistic",
      "altLabels": [
        "Area Indicator",
        "Geographic Indicator",
        "Statistical Observation",
        "Small-Area Estimate"
      ],
      "definition": "One published figure for a geographic area over a period: a named measure (a count, percent or rate) for a tract, town or county in a given year or week, with its unit and, when modelled, confidence bounds. Agencies release such aggregates instead of individual records.",
      "conceptKind": "measurement",
      "broaderRoot": "quantity",
      "closeMatch": [
        "schema:Observation"
      ],
      "broadMatch": [
        "wd:Q4692253"
      ],
      "structure": {
        "kind": "entity",
        "fields": [
          {
            "name": "geographyCode",
            "type": "string",
            "classification": "public",
            "description": "Code of the area, e.g. tract GEOID or town code (SDMX refArea)"
          },
          {
            "name": "geographyName",
            "type": "string",
            "classification": "public"
          },
          {
            "name": "geographyType",
            "type": "string",
            "classification": "public",
            "description": "e.g. census tract, town, county, state"
          },
          {
            "name": "year",
            "type": "integer",
            "classification": "public"
          },
          {
            "name": "periodStart",
            "type": "date",
            "classification": "public",
            "description": "Start of the reference period (SDMX refPeriod)"
          },
          {
            "name": "periodEnd",
            "type": "date",
            "classification": "public"
          },
          {
            "name": "measureCode",
            "type": "string",
            "classification": "public",
            "description": "Short id of the measure"
          },
          {
            "name": "measureName",
            "type": "string",
            "classification": "public",
            "description": "What is measured (schema variableMeasured)"
          },
          {
            "name": "category",
            "type": "string",
            "classification": "public",
            "description": "Topic group of the measure"
          },
          {
            "name": "value",
            "type": "number",
            "classification": "public",
            "description": "The figure (SDMX obsValue)"
          },
          {
            "name": "valueType",
            "type": "string",
            "classification": "public",
            "description": "e.g. count, crude prevalence, age-adjusted rate, percent"
          },
          {
            "name": "unit",
            "type": "string",
            "classification": "public",
            "description": "Unit of the value (SDMX unitMeasure)"
          },
          {
            "name": "lowConfidenceLimit",
            "type": "number",
            "classification": "public"
          },
          {
            "name": "highConfidenceLimit",
            "type": "number",
            "classification": "public"
          },
          {
            "name": "populationBase",
            "type": "integer",
            "classification": "public",
            "description": "Population the figure describes (schema measurementDenominator)"
          },
          {
            "name": "dataSource",
            "type": "string",
            "classification": "public",
            "description": "Survey or system the figure is derived from"
          },
          {
            "name": "footnote",
            "type": "string",
            "classification": "public",
            "description": "Suppression or quality note"
          }
        ]
      },
      "sourceAttribution": {
        "importedFrom": "https://www.w3.org/TR/vocab-data-cube/",
        "authoredBy": [
          "SchemaLattice civic-services pilot"
        ],
        "sourceNotes": "W3C RDF Data Cube / SDMX components (refArea, refPeriod, obsValue, unitMeasure) and schema.org Observation (observationAbout, observationPeriod, variableMeasured, value, unitText, marginOfError, measurementDenominator), with field names from CDC PLACES 2025 (locationid, year, measureid, measure, category, data_value, data_value_unit, data_value_type, low/high_confidence_limit, totalpopulation, datasource) and CT DSS / evictions / affordable-housing aggregates."
      }
    },
