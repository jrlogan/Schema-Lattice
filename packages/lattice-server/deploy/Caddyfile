# Caddy terminates TLS and proxies to the app on loopback.
# DECISIONS.md § Infrastructure: Caddy for automatic HTTPS.
#
#   sudo cp deploy/Caddyfile /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# Canonical concept URIs are independent of the host serving them, so a
# record minted under one hostname resolves unchanged under any other.
# That is what lets these blocks come and go safely.

(lattice) {
	encode zstd gzip

	# Canonical URI resolution and the read surface are public.
	# Write tools carry their own Bearer check inside the app.
	reverse_proxy 127.0.0.1:7000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}
}

schemalattice.com {
	import lattice
	log {
		output file /var/log/caddy/schemalattice.log
	}
}

www.schemalattice.com {
	redir https://schemalattice.com{uri} permanent
}

# The bootstrap hostname from before the domain existed. Kept so anything
# already pointed at it — earlier sessions, the pilot driver, saved prompts —
# keeps working. Safe to delete once nothing uses it.
34.75.250.234.sslip.io {
	import lattice
}

